# ==========================================
# 🤖 DISCORD BOT CREDENTIALS & ROUTING
# ==========================================
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_GUILD_ID=
DISCORD_COMMAND_PREFIX=!

# Multi-Channel Routing (Paste Target Discord Channel IDs)
# 🌅 8:00 AM Morning Macro Briefing + Trader Advisory
DISCORD_MACRO_CHANNEL_ID=123456789012345678

# 📅 8:00 AM Economic Calendar & AI Event Risk Assessment
DISCORD_CALENDAR_CHANNEL_ID=

# 🇵🇱 Polish Markets & GPW News (Parkiet, Bankier)
DISCORD_NEWS_PL_CHANNEL_ID=

# 🌐 Global & USA Macro News Feed
DISCORD_NEWS_GLOBAL_CHANNEL_ID=

# ==========================================
# 🧠 GOOGLE GEMINI AI CONFIGURATION
# ==========================================
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
PROMPTS_DIR=prompts

# ==========================================
# 📈 TRACKED ASSET TICKERS (COMMAS SEPARATED)
# ==========================================
# Format: SYMBOL=YAHOO_TICKER
# Expandable: e.g. DXY, EUR/USD, DAX, BTC, WIG20, SPX, GOLD, OIL
TICKERS=DXY=DX-Y.NYB,EUR/USD=EURUSD=X,DAX=^GDAXI,BTC=BTC-USD,WIG20=WIG20.WA,GOLD=GC=F

# ==========================================
# ⏰ SCHEDULE & TIMEZONE SETTINGS
# ==========================================
BRIEFING_TIME=08:00
BRIEFING_TIMEZONE=Europe/Warsaw

# ==========================================
# ⚙️ APPLICATION & LOGGING
# ==========================================
LOG_LEVEL=INFO
ENVIRONMENT=development
