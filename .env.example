# ==========================================
# 🤖 DISCORD BOT CREDENTIALS & ROUTING
# ==========================================
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_GUILD_ID=
DISCORD_COMMAND_PREFIX=!
VIP_ROLE_NAME=Newsbox-vip

# Multi-Channel Routing (Paste Target Discord Channel IDs)
# 🌅 8:00 AM Morning Macro Briefing & FX/DAX Advisory
DISCORD_MACRO_CHANNEL_ID=123456789012345678

# 📅 8:00 AM Economic Calendar & AI Event Risk Assessment
DISCORD_CALENDAR_CHANNEL_ID=

# 🇵🇱 Polish Markets & GPW News (Parkiet, Bankier)
DISCORD_NEWS_PL_CHANNEL_ID=

# 🌐 Global & USA Macro News Feed (Flash News Co 30 min)
DISCORD_NEWS_GLOBAL_CHANNEL_ID=1544598484961722409

# 🪙 Dedicated Crypto News Feed (#crypto-chat)
DISCORD_CRYPTO_CHANNEL_ID=

# 💼 Portfolio Stocks & Corporate Alerts (#portfolio)
DISCORD_PORTFOLIO_CHANNEL_ID=

# ==========================================
# 🧠 GOOGLE GEMINI AI CONFIGURATION
# ==========================================
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
PROMPTS_DIR=prompts

# ==========================================
# 📈 TRACKED MACRO ASSETS (FX Majors, DXY, DAX)
# ==========================================
TICKERS=DXY=DX-Y.NYB,EUR/USD=EURUSD=X,DAX=^GDAXI,BTC=BTC-USD,GBP/USD=GBPUSD=X,USD/JPY=USDJPY=X

# ==========================================
# 💼 PORTFOLIO WATCHLIST (YOUR STOCKS)
# ==========================================
PORTFOLIO_TICKERS=CDR.WA,PKN.WA,NVDA,TSLA,AAPL

# ==========================================
# ⏳ MARKET OPEN QUIET WINDOWS (HH:MM-HH:MM CET)
# ==========================================
# Bot suppresses general news chatter during opening minutes to prevent distraction
SESSION_QUIET_WINDOWS=08:50-09:15,15:20-15:45

# ==========================================
# ⏰ SCHEDULE & TIMEZONE SETTINGS
# ==========================================
CALENDAR_TIME=07:00
BRIEFING_TIME=08:00
ACCURACY_TIME=12:30
BRIEFING_TIMEZONE=Europe/Warsaw

# ==========================================
# ⚙️ APPLICATION & LOGGING
# ==========================================
LOG_LEVEL=INFO
ENVIRONMENT=production
